# ============================================================================
#  HackAlem / QBERS — environment template
#  setup.sh copies this to .env (gitignored) and prompts for the blank values.
#  Get the real values from a teammate over a private channel — never commit .env.
# ============================================================================

# ---- Django ----------------------------------------------------------------
# setup.sh generates a secret key automatically
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=hackalem
POSTGRES_USER=hackalem
POSTGRES_PASSWORD=hackalem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Google Cloud ----------------------------------------------------------
# API key used for Maps + Charts (browser-visible; restrict it to your
# domains in Google Cloud Console → APIs & Services → Credentials).
GOOGLE_API_KEY=
# OAuth "Sign in with Google". The client ID is public; the SECRET is server-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Analytics 4 uses a Measurement ID (G-XXXXXXXXXX), not the API key.
GA_MEASUREMENT_ID=

# ---- AWS -------------------------------------------------------------------
AWS_CONSOLE_URL=
AWS_CONSOLE_USERNAME=
AWS_CONSOLE_PASSWORD=
# Programmatic access (boto3) needs IAM access keys, not the console password.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Frontend (only VITE_* values are exposed to the browser) ---------------
VITE_GOOGLE_API_KEY=${GOOGLE_API_KEY}
VITE_GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
VITE_GA_MEASUREMENT_ID=${GA_MEASUREMENT_ID}
VITE_FONTAWESOME_KIT_URL=https://kit.fontawesome.com/cf94e53fe5.js
VITE_FONT_SANS=Rubik
VITE_FONT_SERIF="EB Garamond"
