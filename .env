GOOGLE_API_KEY=AIzaSyApTuJWq5Qbujzyu_mw_jTpLFVddqtpMR8
# OAuth "Sign in with Google". The client ID is public; the SECRET is server-only.
GOOGLE_OAUTH_CLIENT_ID=1044624454983-akhmbfk47qob456kptcuu5mrci10fn99.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
